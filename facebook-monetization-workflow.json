              "name": "messages",
              "value": "={{[\n  {\n    \"role\": \"system\",\n    \"content\": \"You are an expert content creator for social media. Create engaging Facebook posts that include: 1) A compelling hook, 2) Valuable information, 3) A subtle call-to-action, 4) Relevant hashtags. Focus on topics: personal finance, productivity, health & wellness, online business. Include affiliate product recommendations naturally.\"\n  },\n  {\n    \"role\": \"user\",\n    \"content\": \"Create a Facebook post about {{ $json.topic || 'building passive income streams' }}. Include a natural recommendation for a relevant affiliate product. Make it engaging and valuable.\"\n  ]\n]}}"
            },
            {
