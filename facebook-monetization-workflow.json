              "value": 500
            },
            {
              "name": "temperature",
              "value": 0.8
            }
          ]
        }
      },
      "id": "content_generator",
      "name": "AI Content Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai_credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract content from OpenAI response and add metadata\nconst aiResponse = $input.first().json;\nconst content = aiResponse.choices[0].message.content;\n\n// Parse content to extract different sections\nconst lines = content.split('\\n').filter(line => line.trim());\nconst mainContent = lines.slice(0, -2).join('\\n');\nconst hashtags = lines[lines.length - 1];\n\n// Add tracking parameters and affiliate links\nconst affiliateLinks = {\n  'productivity': 'https://amzn.to/3ProductivityBook?tag=youraffid-20',\n  'finance': 'https://amzn.to/3FinanceBook?tag=youraffid-20',\n  'health': 'https://amzn.to/3HealthBook?tag=youraffid-20',\n  'business': 'https://amzn.to/3BusinessBook?tag=youraffid-20'\n};\n\n// Generate unique tracking ID\nconst trackingId = `fb_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n\n// Create final post content\nconst finalContent = `${mainContent}\\n\\n💡 Learn more: ${affiliateLinks.business}\\n\\n${hashtags}\\n\\n#TrackingID: ${trackingId}`;\n\nreturn {\n  content: finalContent,\n  trackingId: trackingId,\n  timestamp: new Date().toISOString(),\n  topic: 'passive income',\n  affiliateLink: affiliateLinks.business\n};"
      },
      "id": "content_processor",
      "name": "Content Processor",
      "type": "n8n-nodes-base.code",
