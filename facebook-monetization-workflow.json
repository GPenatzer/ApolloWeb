    {
      "parameters": {
        "jsCode": "// Process Facebook webhook data for engagement tracking\nconst webhookData = $input.first().json;\n\nif (webhookData.entry && webhookData.entry[0].changes) {\n  const changes = webhookData.entry[0].changes;\n  \n  for (const change of changes) {\n    if (change.field === 'feed' && change.value) {\n      const value = change.value;\n      \n      // Track different engagement types\n      if (value.verb === 'add' && value.item === 'comment') {\n        return {\n          type: 'comment',\n          postId: value.post_id,\n          userId: value.from?.id,\n          message: value.message,\n          timestamp: new Date().toISOString()\n        };\n      }\n      \n      if (value.verb === 'add' && value.item === 'like') {\n        return {\n          type: 'like',\n          postId: value.post_id,\n          userId: value.from?.id,\n          timestamp: new Date().toISOString()\n        };\n      }\n      \n      if (value.verb === 'add' && value.item === 'share') {\n        return {\n          type: 'share',\n          postId: value.post_id,\n          userId: value.from?.id,\n          timestamp: new Date().toISOString()\n        };\n      }\n    }\n  }\n}\n\nreturn null;"
      },
